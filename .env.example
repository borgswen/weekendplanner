# Alleen nodig als je zonder Portainer draait (docker compose --env-file .env up -d).
# In Portainer zet je deze waarden bij "Environment variables" van de stack.
CLAUDE_CODE_OAUTH_TOKEN=
ICAL_IK=
ICAL_VRIENDIN=
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
PUBLIEKE_URL=http://192.168.68.125:8088
DATA_DIR=/opt/weekendplanner/data

# Treinprijzen (optioneel, maar maakt de prijzen beter):
# leeftijden van de reizigers (DB geeft onder 27 jaar jongerenprijzen), bijv. 22,23
LEEFTIJDEN=
# studentenreisproduct per reiziger in dezelfde volgorde: weekend, week of geen
STUDENTENOV=
# gratis sleutel van https://apiportal.ns.nl voor binnenlandse NS-prijzen
NS_API_KEY=
